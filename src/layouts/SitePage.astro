---
/*
  SitePage: the shared shell for inner pages (head, nav, footer).

  <SitePage title="About" description="…">…</SitePage>
  Pass noindex for placeholder pages that shouldn't show up in search yet.
*/
import '../styles/brand.css';
import '../styles/site.css';
import ColorTokens from '../components/ColorTokens.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{title} · {SITE_TITLE}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<ColorTokens />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Hanken+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteNav />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>

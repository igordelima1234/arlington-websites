		<footer class="foot wrap">
			<span class="t-small muted">{BRAND} brand guide · draft</span>
			<span class="toast" id="copied" role="status" aria-live="polite"></span>
		</footer>

		<script>
			const out = document.getElementById("copied");
			let timer: number | undefined;
			const toast = (msg: string) => {
				if (!out) return;
				out.textContent = msg;
				out.classList.add("show");
				clearTimeout(timer);
				timer = window.setTimeout(() => out.classList.remove("show"), 1800);
			};
			document.querySelectorAll<HTMLElement>("[data-hex], [data-copy]").forEach((el) => {
				el.addEventListener("click", async () => {
					const text = el.dataset.hex ?? el.dataset.copy!;
					try {
						await navigator.clipboard.writeText(text);
						toast(`Copied ${text}`);
					} catch {
						toast(text);
					}
				});
			});
		</script>

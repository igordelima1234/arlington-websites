---
import "../styles/brand.css";
import Icon from "../components/Icon.astro";
import { icons, iconCategories } from "../icons";
import ColorTokens from "../components/ColorTokens.astro";
import { scales, STEPS, anchors, scaleInfo, tokenGroups, allTokens, pairs, dataviz, resolve, contrast, bestText } from "../colors";

const BRAND = "Arlington Websites";
const TAGLINE = "Marketing for the businesses on your block.";

const core = [
	{ name: "Blue", ref: "blue.600", hex: scales.blue[600], role: "Primary. CTAs, links, key moments. Use with intent." },
	{ name: "Graphite", ref: "neutral.950", hex: scales.neutral[950], role: "Text, dark sections, footer." },
	{ name: "Coconut", ref: "neutral.50", hex: scales.neutral[50], role: "Default page background. Warm, not stark white." },
];

const anchorAt = (scale: string, step: number) =>
	Object.entries(anchors).find(([, a]) => a.scale === scale && a.step === step)?.[0];

const tok = (name: string) => allTokens.find((t) => t.name === name)!;
const ratio = (fg: string, bg: string, theme: "light" | "dark") =>
	contrast(resolve(tok(fg)[theme]), resolve(tok(bg)[theme]));
const grade = (r: number, min: number) =>
	min === 3
		? { ok: r >= 3, label: r >= 3 ? "3:1 ✓" : "Fail" }
		: r >= 7 ? { ok: true, label: "AAA" } : r >= 4.5 ? { ok: true, label: "AA" } : { ok: false, label: "Fail" };

const checks = [
	{ label: "Body text on page", fg: "text-primary", bg: "bg-canvas", min: 4.5 },
	{ label: "Body text on card", fg: "text-primary", bg: "bg-surface", min: 4.5 },
	{ label: "Secondary text on page", fg: "text-secondary", bg: "bg-canvas", min: 4.5 },
	{ label: "Secondary text on card", fg: "text-secondary", bg: "bg-surface", min: 4.5 },
	{ label: "Tertiary text on page", fg: "text-tertiary", bg: "bg-canvas", min: 4.5 },
	{ label: "Tertiary text on card", fg: "text-tertiary", bg: "bg-surface", min: 4.5 },
	{ label: "Link on page", fg: "text-link", bg: "bg-canvas", min: 4.5 },
	{ label: "Primary button label", fg: "on-action-primary", bg: "action-primary", min: 4.5 },
	{ label: "Inverse band text", fg: "text-inverse", bg: "bg-inverse", min: 4.5 },
	{ label: "Success message", fg: "success-fg", bg: "success-bg", min: 4.5 },
	{ label: "Warning message", fg: "warning-fg", bg: "warning-bg", min: 4.5 },
	{ label: "Error message", fg: "danger-fg", bg: "danger-bg", min: 4.5 },
	{ label: "Info message", fg: "info-fg", bg: "info-bg", min: 4.5 },
	{ label: "Input border on card", fg: "border-strong", bg: "bg-surface", min: 3 },
	{ label: "Focus ring on page", fg: "border-focus", bg: "bg-canvas", min: 3 },
];

const scale = [
	{ name: "Display XL", cls: "t-dxl", spec: "Schibsted Grotesk 800 · 104/96 · −3%", sample: "Get found." },
	{ name: "Display L", cls: "t-dl", spec: "Schibsted Grotesk 800 · 72/68 · −3%", sample: "Be the local favorite." },
	{ name: "H1", cls: "t-h1", spec: "Schibsted Grotesk 700 · 52/56 · −2%", sample: "Websites that bring in calls" },
	{ name: "H2", cls: "t-h2", spec: "Schibsted Grotesk 700 · 36/40 · −1.5%", sample: "Local SEO, done right" },
	{ name: "H3", cls: "t-h3", spec: "Schibsted Grotesk 700 · 22/28 · −1%", sample: "Google Business Profile" },
	{ name: "Body L", cls: "t-bl", spec: "Hanken Grotesk 400 · 20/30", sample: "We help neighborhood businesses show up where customers are already looking." },
	{ name: "Body", cls: "t-b", spec: "Hanken Grotesk 400 · 17/27", sample: "Plain language, real numbers, and a team you can actually call." },
	{ name: "Label", cls: "t-label", spec: "IBM Plex Mono 500 · 12/16 · +8% · caps", sample: "Case study · 2026" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Brand Guide · {BRAND}</title>
		<ColorTokens />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Hanken+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<div class="wrap nav-inner">
				<a class="logo" href="#top">{BRAND}</a>
				<nav class="nav-links" aria-label="Sections">
					<a href="#logo">Logo</a>
					<a href="#color">Color</a>
					<a href="#type">Type</a>
					<a href="#icons">Icons</a>
					<a href="#ui">Components</a>
					<a href="#voice">Voice</a>
				</nav>
			</div>
		</header>

		<main id="top">
			<!-- Hero -->
			<section class="hero wrap">
				<p class="t-label">Brand foundations · v0.1</p>
				<h1 class="t-dxl">{TAGLINE}</h1>
				<p class="t-bl hero-sub">
					{BRAND} is a local marketing agency. The brand is direct, warm and confident: lots of
					space, one bold blue, and color pairs used like signage. This page is the source of truth
					for building the site.
				</p>
			</section>

			<!-- Logo -->
			<section id="logo" class="section wrap">
				<div class="section-head">
					<p class="t-label">01</p>
					<h2 class="t-h1">Logo</h2>
					<p class="t-b muted">
						A wordmark only: the name set in Schibsted Grotesk 800 with tight tracking, and no
						symbol. Use Graphite or Blue on light backgrounds and Coconut or white on dark ones. Keep
						clear space equal to the cap height on every side.
					</p>
				</div>
				<div class="logo-grid">
					{[
						{ bg: "var(--c-white)", fg: "var(--c-graphite)" },
						{ bg: "var(--c-blue)", fg: "#fff" },
						{ bg: "var(--c-graphite)", fg: "var(--c-coconut)" },
					].map((v) => (
						<div class="logo-tile" style={`background:${v.bg};color:${v.fg}`}>
							<span class="logo logo-lg">{BRAND}</span>
						</div>
					))}
				</div>
			</section>

			<!-- Color -->
			<section id="color" class="section wrap">
				<div class="section-head">
					<p class="t-label">02</p>
					<h2 class="t-h1">Color</h2>
					<p class="t-b muted">
						The system has three layers. Brand colors set the personality. Tonal scales give every
						hue a full range from 50 to 950. Semantic tokens tell components which step to use in
						light and dark themes. Build with tokens and never with raw hex values. Click any
						swatch to copy it.
					</p>
				</div>

				<p class="t-label layer-label">Layer 1 · Brand colors</p>
				<div class="core-grid">
					{core.map((c) => (
						<button class="swatch swatch-core" style={`background:${c.hex};color:${bestText(c.hex)}`} data-hex={c.hex}>
							<span class="t-h2">{c.name}</span>
							<span class="swatch-meta">
								<span class="t-label">{c.hex} · {c.ref}</span>
								<span class="t-small">{c.role}</span>
							</span>
						</button>
					))}
				</div>

				<h3 class="t-h3 sub">Accent pairs</h3>
				<p class="t-b muted sub-note">Each pair is two steps of the same scale. One is always the background and the other the type. Never mix pairs.</p>
				<div class="pair-grid">
					{pairs.map((p) => {
						const bg = resolve(p.bg), fg = resolve(p.fg);
						return (
							<button class="swatch swatch-pair" style={`background:${bg};color:${fg}`} data-hex={bg}>
								<span class="t-dl pair-aa">Aa</span>
								<span class="swatch-meta">
									<span class="t-h3">{p.name}</span>
									<span class="t-label">{p.bg} / {p.fg}</span>
									<span class="t-small">{p.use} · {contrast(bg, fg).toFixed(1)}:1</span>
								</span>
							</button>
						);
					})}
				</div>

				<p class="t-label layer-label">Layer 2 · Tonal scales</p>
				<p class="t-b muted sub-note">
					Generated in OKLCH so each step looks evenly spaced. ● marks the step where a brand color
					sits. Each chip shows its contrast with white (W) or Graphite (G) text. For text on white,
					use step 600 or darker. For icons and borders, 500 or darker.
				</p>
				<div class="scales">
					<div class="scale-steps" aria-hidden="true">
						<span></span>
						{STEPS.map((st) => <span class="t-label muted">{st}</span>)}
					</div>
					{(Object.keys(scales) as (keyof typeof scales)[]).map((name) => (
						<div class="scale-line">
							<div class="scale-name">
								<span class="t-h3">{scaleInfo[name].label}</span>
								<span class="t-small muted">{scaleInfo[name].role}</span>
							</div>
							{STEPS.map((st) => {
								const hex = scales[name][st];
								const fg = bestText(hex);
								const anchor = anchorAt(name, st);
								return (
									<button class="chip" style={`background:${hex};color:${fg}`} data-hex={hex} title={`--${name}-${st} ${hex}${anchor ? ` · ${anchor}` : ""}`}>
										<span class="chip-step">{st}{anchor && <b> ●</b>}</span>
										<span class="chip-hex">{hex.slice(1)}</span>
										<span class="chip-ratio">{fg === "#FFFFFF" ? "W" : "G"} {contrast(hex, fg).toFixed(1)}</span>
									</button>
								);
							})}
						</div>
					))}
				</div>

				<p class="t-label layer-label">Layer 3 · Semantic tokens</p>
				<p class="t-b muted sub-note">
					Components use these names and nothing else. Each token points to a scale step in each
					theme, so dark mode is a token swap rather than a redesign. In CSS:
					<code>color: var(--text-secondary)</code>.
				</p>
				<div class="token-table" role="table">
					<div class="tok-row tok-head" role="row">
						<span class="t-label muted" role="columnheader">Token</span>
						<span class="t-label muted" role="columnheader">Use</span>
						<span class="t-label muted" role="columnheader">Light</span>
						<span class="t-label muted" role="columnheader">Dark</span>
					</div>
					{tokenGroups.map((g) => (
						<>
							<div class="tok-group t-label" role="row"><span role="cell">{g.group}</span></div>
							{g.tokens.map((t) => (
								<div class="tok-row" role="row">
									<code role="cell">--{t.name}</code>
									<span class="t-small muted" role="cell">{t.role}</span>
									<span class="tok-val" role="cell"><i style={`background:${resolve(t.light)}`}></i><span class="t-small">{t.light}</span></span>
									<span class="tok-val" role="cell"><i style={`background:${resolve(t.dark)}`}></i><span class="t-small">{t.dark}</span></span>
								</div>
							))}
						</>
					))}
				</div>

				<h3 class="t-h3 sub">Light & dark</h3>
				<p class="t-b muted sub-note">The same markup rendered with each theme's tokens.</p>
				<div class="theme-grid">
					{["light", "dark"].map((theme) => (
						<div class="theme-panel" data-theme={theme}>
							<span class="t-label tp-tertiary">{theme} theme</span>
							<div class="tp-card">
								<h4 class="t-h2">Free local visibility audit</h4>
								<p class="t-b tp-secondary">See how you show up on Google Maps and search compared with competitors nearby.</p>
								<label class="tp-field">
									<span class="t-small">Business name</span>
									<input type="text" placeholder="e.g. Clarendon Coffee Co." />
								</label>
								<div class="row">
									<a class="tp-btn" href="#color"><span>Get my audit</span><Icon name="arrow-right" /></a>
									<a class="tp-link" href="#color">How it works</a>
								</div>
								<p class="t-small tp-tertiary">Takes 2 minutes · No commitment</p>
								<div class="alert alert-success"><Icon name="check" size={20} /><span class="t-small">Audit requested. Check your inbox.</span></div>
							</div>
						</div>
					))}
				</div>

				<h3 class="t-h3 sub">Status</h3>
				<p class="t-b muted sub-note">
					Status colors only ever signal state. Pair each one with an icon and words, never color
					alone. Tangerine is a brand accent and is not used for errors.
				</p>
				<div class="alert-grid">
					<div class="alert alert-success"><Icon name="check" size={20} /><span class="t-small"><b>Success.</b> Your site is live.</span></div>
					<div class="alert alert-warning"><Icon name="alert" size={20} /><span class="t-small"><b>Warning.</b> Your SSL certificate expires in 7 days.</span></div>
					<div class="alert alert-danger"><Icon name="alert" size={20} /><span class="t-small"><b>Error.</b> Enter a valid phone number.</span></div>
					<div class="alert alert-info"><Icon name="info" size={20} /><span class="t-small"><b>Info.</b> Reports update every Monday.</span></div>
				</div>

				<h3 class="t-h3 sub">Contrast checks</h3>
				<p class="t-b muted sub-note">
					Calculated from the tokens when the site builds. Text needs 4.5:1 (AA). Borders, focus
					rings and icons need 3:1.
				</p>
				<div class="contrast-table" role="table">
					<div class="cx-row cx-head" role="row">
						<span class="t-label muted" role="columnheader">Pairing</span>
						<span class="t-label muted" role="columnheader">Light</span>
						<span class="t-label muted" role="columnheader">Dark</span>
					</div>
					{checks.map((c) => (
						<div class="cx-row" role="row">
							<span role="cell">
								<span class="t-small">{c.label}</span>
								<code class="cx-code">{c.fg} on {c.bg}</code>
							</span>
							{(["light", "dark"] as const).map((th) => {
								const r = ratio(c.fg, c.bg, th);
								const lvl = grade(r, c.min);
								const fg = resolve(tok(c.fg)[th]), bg = resolve(tok(c.bg)[th]);
								return (
									<span class="cx-cell" role="cell">
										<span class="cx-sample" style={`background:${bg};color:${fg};box-shadow:inset 0 0 0 1px ${c.min === 3 ? fg : "transparent"}`}>Aa</span>
										<span class="t-small">{r.toFixed(2)}:1</span>
										<span class={`badge badge-${lvl.ok ? "pass" : "fail"}`}>{lvl.label}</span>
									</span>
								);
							})}
						</div>
					))}
				</div>

				<h3 class="t-h3 sub">Data visualization</h3>
				<p class="t-b muted sub-note">
					For charts in reports and case studies. Use categorical colors from the left and no
					more than six series. Each one is at least 3:1 against white, so lines and bars stay
					visible.
				</p>
				<div class="dv">
					<div class="dv-row">
						<span class="t-label muted dv-label">Categorical</span>
						<div class="dv-cats">
							{dataviz.categorical.map((r, i) => (
								<button class="dv-cat" data-hex={resolve(r)}>
									<i style={`background:${resolve(r)}`}></i>
									<span class="t-small">{i + 1}. {r}</span>
									<span class="t-label muted">{contrast(resolve(r), "#FFFFFF").toFixed(1)}:1</span>
								</button>
							))}
						</div>
					</div>
					<div class="dv-row">
						<span class="t-label muted dv-label">Sequential</span>
						<div class="dv-strip">{dataviz.sequential.map((r) => <i style={`background:${resolve(r)}`} title={r}></i>)}</div>
					</div>
					<div class="dv-row">
						<span class="t-label muted dv-label">Diverging</span>
						<div class="dv-strip">{dataviz.diverging.map((r) => <i style={`background:${resolve(r)}`} title={r}></i>)}</div>
					</div>
				</div>

				<h3 class="t-h3 sub">Proportion</h3>
				<div class="ratio" role="img" aria-label="Color proportion: 60% Coconut, 25% Graphite, 10% Blue, 5% accents">
					<span style="flex:60;background:var(--c-coconut);color:var(--c-graphite)">Coconut 60</span>
					<span style="flex:25;background:var(--c-graphite);color:var(--c-coconut)">Graphite 25</span>
					<span style="flex:10;background:var(--c-blue);color:#fff">Blue 10</span>
					<span style="flex:5;background:var(--c-tangerine)"></span>
				</div>
			</section>

			<!-- Type -->
			<section id="type" class="section wrap">
				<div class="section-head">
					<p class="t-label">03</p>
					<h2 class="t-h1">Typography</h2>
					<p class="t-b muted">
						Tight, heavy grotesk headlines over a friendly, readable text face, with a mono for
						small labels. Schibsted Grotesk, Hanken Grotesk and IBM Plex Mono are free Google Fonts that
						stand in for Sharp Grotesk, Atlas Grotesk and Atlas Typewriter.
					</p>
				</div>

				<div class="font-cards">
					<div class="font-card">
						<span class="t-label">Display</span>
						<span class="font-aa" style="font-family:var(--font-display);font-weight:800">Aa</span>
						<span class="t-h3">Schibsted Grotesk</span>
						<span class="t-small muted">500 · 700 · 800</span>
					</div>
					<div class="font-card">
						<span class="t-label">Text</span>
						<span class="font-aa" style="font-family:var(--font-body);font-weight:500">Aa</span>
						<span class="t-h3">Hanken Grotesk</span>
						<span class="t-small muted">400 · 500 · 600</span>
					</div>
					<div class="font-card">
						<span class="t-label">Label</span>
						<span class="font-aa" style="font-family:var(--font-mono);font-weight:500">Aa</span>
						<span class="t-h3">IBM Plex Mono</span>
						<span class="t-small muted">500, caps only</span>
					</div>
				</div>

				<div class="scale">
					{scale.map((s) => (
						<div class="scale-row">
							<div class="scale-meta">
								<span class="t-h3">{s.name}</span>
								<span class="t-label muted">{s.spec}</span>
							</div>
							<p class={s.cls}>{s.sample}</p>
						</div>
					))}
				</div>
			</section>

			<!-- Icons -->
			<section id="icons" class="section wrap">
				<div class="section-head">
					<p class="t-label">04</p>
					<h2 class="t-h1">Icons</h2>
					<p class="t-b muted">
						A small set of line icons drawn on one grid. Their square ends and sharp corners match
						the headline type and the flat UI. Icons support words and never replace them. Click
						any icon to copy its component code.
					</p>
				</div>

				<div class="icon-spec">
					<div class="icon-construct" aria-hidden="true">
						<svg viewBox="0 0 24 24">
							{Array.from({ length: 23 }, (_, i) => (
								<>
									<line x1={i + 1} y1="0" x2={i + 1} y2="24" class="g" />
									<line x1="0" y1={i + 1} x2="24" y2={i + 1} class="g" />
								</>
							))}
							<rect x="2" y="2" width="20" height="20" class="live" />
							<g class="glyph" set:html={icons["storefront"]} />
						</svg>
					</div>
					<dl class="spec-list">
						<div><dt class="t-label">Grid</dt><dd>24 × 24 with 2px padding, giving a 20 × 20 live area</dd></div>
						<div><dt class="t-label">Stroke</dt><dd>2px, outline only, no fills</dd></div>
						<div><dt class="t-label">Ends & corners</dt><dd>Square caps, miter joins. Curves only where the object is round.</dd></div>
						<div><dt class="t-label">Color</dt><dd>One color, inherited from the text (<code>currentColor</code>)</dd></div>
						<div><dt class="t-label">Sizes</dt><dd>16 inline · 20 buttons · 24 UI default · 32 spot icons</dd></div>
						<div><dt class="t-label">Code</dt><dd><code>&lt;Icon name="phone" /&gt;</code> in <code>src/components/Icon.astro</code></dd></div>
					</dl>
				</div>

				<div class="icon-sizes">
					{[16, 20, 24, 32].map((s) => (
						<div class="icon-size">
							<Icon name="map-pin" size={s as 16 | 20 | 24 | 32} />
							<span class="t-label muted">{s}px</span>
						</div>
					))}
				</div>

				{iconCategories.map((cat) => (
					<div class="icon-cat">
						<div class="icon-cat-head">
							<h3 class="t-h3">{cat.name}</h3>
							<p class="t-small muted">{cat.note}</p>
						</div>
						<div class="icon-grid">
							{cat.icons.map((n) => (
								<button class="icon-cell" data-copy={`<Icon name="${n}" />`} title={`Copy <Icon name="${n}" />`}>
									<Icon name={n} size={24} />
									<span class="t-small">{n}</span>
								</button>
							))}
						</div>
					</div>
				))}

				<h3 class="t-h3 sub">Spot icons</h3>
				<p class="t-b muted spot-note">
					On service and stat cards, a 32px icon sits in a 56px square that uses one accent pair.
					Use one spot icon per card, and only one accent pair in a row of cards.
				</p>
				<div class="spot-grid">
					{[
						{ icon: "website", label: "Websites", bg: "var(--c-sky)", fg: "var(--c-navy)" },
						{ icon: "map-pin", label: "Local SEO", bg: "var(--c-lime)", fg: "var(--c-forest)" },
						{ icon: "megaphone", label: "Ads", bg: "#FFD3C2", fg: "#8A2A0A" },
						{ icon: "users", label: "Social", bg: "var(--c-pink)", fg: "var(--c-plum)" },
					].map((s) => (
						<div class="spot-card">
							<span class="spot" style={`background:${s.bg};color:${s.fg}`}>
								<Icon name={s.icon as any} size={32} />
							</span>
							<span class="t-h3">{s.label}</span>
						</div>
					))}
				</div>

				<div class="icon-rules">
					<div class="voice-card">
						<h3 class="t-h3">Do</h3>
						<p class="t-b">Pair icons with a label. Use the next size up rather than scaling by eye. Keep them the same color as the text beside them.</p>
					</div>
					<div class="voice-card">
						<h3 class="t-h3">Don't</h3>

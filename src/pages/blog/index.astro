---
/*
  /blog: shows "coming soon" until the first post is added to src/content/blog/.
*/
import { getCollection } from 'astro:content';
import SitePage from '../../layouts/SitePage.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SitePage
	title="Blog"
	description="Plain-English marketing tips for small businesses in Arlington and DFW."
	noindex={posts.length === 0}
>
	{posts.length === 0 ? (
		<ComingSoon
			icon="pen"
			title="The blog is on its way."
			lede="Plain-English marketing tips for small businesses: no jargon, nothing you need a marketing degree to use."
			pointsTitle="First up"
			points={[
				'How to get more Google reviews (without being pushy)',
				'What a small business website should actually cost',
				'Local SEO basics: showing up in “near me” searches',
			]}
		/>
	) : (
		<section class="wrap blog">
			<Eyebrow>Blog</Eyebrow>
			<h1 class="t-h1">Marketing tips for local businesses.</h1>
			<ul class="posts">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<p class="t-small date"><FormattedDate date={post.data.pubDate} /></p>
							<h2 class="t-h3">{post.data.title}</h2>
							<p class="t-b desc">{post.data.description}</p>
						</a>
					</li>
				))}
			</ul>
		</section>
	)}
</SitePage>

<style>
	.blog { display: grid; gap: var(--s-4); padding-block: var(--s-8) var(--s-9); }
	.posts { list-style: none; padding: 0; margin-top: var(--s-5); display: grid; gap: var(--s-4); }
	.posts a {
		display: grid; gap: var(--s-2);
		padding: var(--s-5);
		border: 1.5px solid var(--text-primary);
		border-radius: var(--radius-m);
		background: var(--bg-surface);
		color: inherit; text-decoration: none;
	}
	.posts a:hover h2 { color: var(--text-link); }
	.date, .desc { color: var(--text-secondary); }
</style>

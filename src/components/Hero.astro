	<div class="wrap hero-inner">
		<div class="hero-copy">
			<Eyebrow>Web design for small businesses</Eyebrow>
			<h1 class="t-dxl">Websites designed to make your phone ring.</h1>
			<p class="t-bl hero-sub">
				Websites, local SEO and ads for small businesses, from a team down the street.
			</p>
			<div class="hero-ctas">
				<a class="btn btn-primary" href="/audit"><span>Get a free audit</span><Icon name="arrow-right" /></a>
				<a class="btn btn-secondary" href="/#work"><span>See our work</span><Icon name="arrow-up-right" /></a>
			</div>
		</div>

		<!--
			Phone story, one 14s loop (all timings share --loop):
			a mobile site for "Your business" gets built section by section.
			Each section shows as a dashed, labeled outline, then fills in; the page
			scrolls as it grows, the URL bar finishes loading, goes "Live", toast.
			Base styles are the finished site, so reduced motion shows that still.
		-->
		<div class="stage" aria-hidden="true">
			<div class="stage-inner">
				<div class="phone">
					<span class="side bs-action"></span>
					<span class="side bs-up"></span>
					<span class="side bs-down"></span>
					<span class="side bs-power"></span>
					<div class="screen">
						<span class="island"></span>
						<div class="statusbar">
							<span class="clock">9:41</span>
							<span class="sb-icons"><span class="signal"><i></i><i></i><i></i><i></i></span><span class="battery"></span></span>
						</div>
						<span class="home"></span>

						<div class="browser">
							<Icon name="website" size={14} />
							<span class="url">yourbusiness.com</span>
							<span class="live"><i></i>Live</span>
							<span class="progress"></span>
						</div>

						<div class="viewport">
							<div class="site">
								<div class="sec s1 s-nav" data-label="Nav">
									<div class="in">
										<span class="brand"><Icon name="storefront" size={16} />Your business</span>
										<span class="burger"><i></i><i></i><i></i></span>
									</div>
								</div>
								<div class="sec s2 s-hero" data-label="Hero">
									<div class="in">
										<strong class="h">Fresh tacos, made daily.</strong>
										<span class="ln"></span>
										<span class="ln ln-s"></span>
										<span class="ctas">
											<span class="b-solid"><Icon name="phone" size={12} />Call now</span>
											<span class="b-line">Menu</span>
										</span>
									</div>
								</div>
								<div class="sec s3 s-img" data-label="Photo">
									<div class="in"><Icon name="camera" size={22} /></div>
								</div>
								<div class="sec s4 s-cards" data-label="Services">
									<div class="in">
										<span class="kicker">What we serve</span>
										<span class="cards">
											{[0, 1, 2].map(() => <span class="card"><b></b><i></i><i class="s"></i></span>)}
										</span>
									</div>
								</div>
								<div class="sec s5 s-reviews" data-label="Reviews">
									<div class="in">
										<span class="mini-stars">
											{stars.map(() => <svg viewBox="0 0 24 24" set:html={icons.star} />)}
										</span>
										<span class="ln"></span>
										<span class="ln ln-s"></span>
										<span class="who">4.9 · 120 Google reviews</span>
									</div>
								</div>
								<div class="sec s6 s-visit" data-label="Visit">
									<div class="in">
										<span class="mini-map">
											<svg viewBox="0 0 230 84" preserveAspectRatio="none">
												<path d="M0 26h230M0 62h230M64 0v84M160 0v84M0 84 96 0" />
											</svg>
											<span class="mm-pin"><Icon name="map-pin" size={22} /></span>
										</span>
										<span class="hours"><Icon name="clock" size={12} />Open today, 11 to 9</span>
									</div>
								</div>
								<div class="sec s7 s-foot" data-label="Footer">
									<div class="in"><span class="ln"></span><span class="ln ln-s"></span></div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="toast">
					<Icon name="check" size={16} />
					<span><strong>Your site</strong> is live</span>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	// Status bar clock: the visitor's local time, phone-style (no AM/PM).
	const clock = document.querySelector<HTMLElement>('.stage .clock');
	if (clock) {
		const tick = () => {
			const now = new Date();
			const h = now.getHours() % 12 || 12;
			clock.textContent = `${h}:${String(now.getMinutes()).padStart(2, '0')}`;
			// Re-run right as the next minute starts
			setTimeout(tick, 60_000 - (now.getSeconds() * 1000 + now.getMilliseconds()));
		};
		tick();
	}

	// Pause the loop while it's off-screen.
	const stage = document.querySelector<HTMLElement>('.stage');
	if (stage && 'IntersectionObserver' in window) {
		new IntersectionObserver(([entry]) => {
			stage.classList.toggle('paused', !entry.isIntersecting);
		}).observe(stage);
	}
</script>


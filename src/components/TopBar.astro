---
/* Announcement bar above the nav. Scrolls away; the nav below stays sticky. */
import Icon from './Icon.astro';

const message = {
	long: 'Free website audit for Arlington small businesses: find out what’s costing you calls.',
	short: 'Free website audit.',
};
const cta = { label: 'Get my audit', href: '/audit' };
---

<div class="topbar">
	<div class="wrap topbar-inner">
		<p>
			<span class="msg-long">{message.long}</span>
			<span class="msg-short">{message.short}</span>
		</p>
		<a class="cta" href={cta.href}>
			<span>{cta.label}</span>
			<Icon name="arrow-right" size={16} />
		</a>
	</div>
</div>

<style>
	.topbar {
		background: var(--action-primary);
		color: var(--on-action-primary);
		font-size: var(--fs-small);
	}
	.topbar-inner {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--s-3) var(--s-4);
		min-height: 44px;
		padding-block: var(--s-2);
	}
	p {
		font-weight: 500;
		line-height: 1.35;
	}
	.msg-long { display: none; }

	.cta {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 6px;
		height: 28px;
		padding: 0 var(--s-3);
		border-radius: 999px;
		background: var(--white);
		color: var(--action-primary);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: background 0.15s ease;
	}
	.cta:hover { background: var(--c-coconut); }
	.cta :global(.icon) { transition: transform 0.2s ease; }
	.cta:hover :global(.icon) { transform: translateX(2px); }
	.cta:focus-visible { outline-color: var(--white); }

	@media (min-width: 768px) {
		.msg-long { display: inline; }
		.msg-short { display: none; }
	}
</style>
